{
  "name": "dsh-skill-manager",
  "version": "1.0.0",
  "description": "Skill Manager (static host): tự kích hoạt các skill đã chọn (⚡) mỗi khi mở harness — đọc .agents/skill-autoload.json và đăng ký systemPrompt sections.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "skill"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
